# Copy to .env and fill in from Supabase -> Project Settings -> API.
# Create a NEW project for this app; do not reuse an existing one.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Storage bucket for event cover images (see supabase/migrations/0004_storage.sql)
VITE_SUPABASE_EVENT_IMAGES_BUCKET=event-images

# NEVER put the service_role key here, or anywhere under src/. It bypasses Row
# Level Security and nothing on the client needs it.
#
# Nor a database password or connection string: this file is committed, so
# anything in it is public. Real values belong in .env, which is gitignored.
